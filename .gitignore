# ---------------------------------------------------------------------------
# Qaniva monorepo .gitignore
# Keep this file conservative: never ignore source, .meta files, or fixtures.
# ---------------------------------------------------------------------------

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# --- Node / TypeScript ---
node_modules/
.pnpm-store/
dist/
build/
coverage/
*.tsbuildinfo
.eslintcache
.turbo/

# --- Env / secrets (NEVER commit real secrets; .env.example IS committed) ---
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# --- React Native / Expo (apps/mobile) ---
apps/mobile/.expo/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/*.jsbundle

# --- .NET (clinical-core) ---
[Bb]in/
[Oo]bj/
*.user
.vs/
TestResults/

# --- Unity (unity/QanivaSimulation) ---
# Only generated/local folders. Assets/, Packages/, ProjectSettings/ ARE tracked.
unity/QanivaSimulation/[Ll]ibrary/
unity/QanivaSimulation/[Tt]emp/
unity/QanivaSimulation/[Oo]bj/
unity/QanivaSimulation/[Ll]ogs/
unity/QanivaSimulation/[Bb]uilds/
unity/QanivaSimulation/[Mm]emoryCaptures/
unity/QanivaSimulation/[Uu]serSettings/
unity/QanivaSimulation/[Cc]rashlytics/
unity/QanivaSimulation/.vsconfig
unity/QanivaSimulation/*.csproj
unity/QanivaSimulation/*.sln
unity/QanivaSimulation/*.unityproj
unity/QanivaSimulation/*.apk
unity/QanivaSimulation/*.aab
unity/QanivaSimulation/*.app
unity/QanivaSimulation/*.ipa
# Vendored build artifacts synced by scripts/sync-clinical-core-to-unity.sh
unity/QanivaSimulation/Assets/Qaniva/Plugins/ClinicalCore/
unity/QanivaSimulation/Assets/Qaniva/Resources/Qaniva/Cases/

# --- scratch ---
scratchpad/
tmp/

# generated protocol description
packages/contracts/generated/

# --- Unity iOS export + vendored framework (build artifacts, regenerate via scripts/export-unity-ios.sh) ---
unity/QanivaSimulation/build/
apps/mobile/unity-frameworks/ios/
apps/mobile/ios/.xcode.env.local
unity-editmode-results.xml
unity-playmode-results.xml

# User-supplied review packaging (byte-identical to docs/audits/product-shell-screenshots/)
docs/audits/product-shell-screenshots.zip
qaniva-final-polish-screenshots.zip
docs/audits/final-polish-screenshots.zip
docs/audits/design-repair-screenshots.zip
qaniva-simulation-redesign-demo.zip
qaniva-turkish-scene-captures.zip
# Owner-supplied third-party patient model (licence: see docs) — not committed
Hospital Patient.zip
art/*.blend
art/*.blend1
# Unity test-runner temp scene (left behind when a batchmode test run is killed)
unity/QanivaSimulation/Assets/InitTestScene*
art/mixamo-upload/
Mixamo/
