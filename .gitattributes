# Normalize line endings
* text=auto eol=lf

# Scripts
*.sh   text eol=lf
*.bat  text eol=crlf

# ---------------------------------------------------------------------------
# Unity — force text serialization diffs and mark binary assets for Git LFS.
# LFS is NOT initialized in this foundation commit (no binary assets yet);
# these rules take effect once `git lfs install` is run. See
# docs/development/local-development.md.
# ---------------------------------------------------------------------------
*.cs      text diff=csharp
*.shader  text
*.cginc   text
*.uxml    text
*.uss     text
*.asmdef  text
*.unity   text
*.prefab  text
*.asset   text
*.mat     text
*.meta    text

# Binary 3D / media assets -> Git LFS
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
