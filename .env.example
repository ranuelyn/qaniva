# ---------------------------------------------------------------------------
# Qaniva — example environment file. Copy to `.env` and fill locally.
# NEVER commit a real `.env`. NEVER put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Backend API (apps/api) ---
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://qaniva:qaniva@localhost:5432/qaniva_dev

# --- Auth (placeholder; auth is not implemented in the MVP foundation) ---
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=3600

# --- AI Gateway ---
# The MVP foundation ships only a deterministic stub provider.
# Real providers are added later, backend-only. Clients never see these.
AI_PROVIDER=stub            # stub | openai | anthropic
AI_API_KEY=
AI_MODEL_PATIENT=
AI_MODEL_DEBRIEF=
AI_REQUEST_TIMEOUT_MS=8000

# --- Analytics ---
ANALYTICS_SINK=stdout       # stdout | http
ANALYTICS_HTTP_ENDPOINT=

# --- Mobile (apps/mobile) — Expo public env vars must be prefixed EXPO_PUBLIC_ ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development
