      "once": true,
      "delaySec": 0,
      "effects": [
        {
          "op": "adjust",
          "target": "vitals.hr",
          "value": -15
        },
        {
          "op": "adjust",
          "target": "vitals.sbpMmHg",
          "value": -20
        },
        {
          "op": "setEnum",
          "target": "circulation",
          "value": "shock"
        },
        {
          "op": "setFlag",
          "flag": "deteriorating"
