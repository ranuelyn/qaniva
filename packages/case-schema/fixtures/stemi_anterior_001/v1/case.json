  "scoringCriteria": [
    {
      "id": "c_time_to_ecg",
      "label": "Obtained the 12-lead ECG promptly",
      "criticality": "critical",
      "acceptedActions": ["ecg_12lead"],
      "timingWindow": {
        "fullCreditBeforeSec": 300,
        "zeroCreditAfterSec": 600
      },
      "stateConstraints": [],
      "points": 15,
      "category": "critical",
      "harmful": false,
      "rationale": "Guideline anchor: ECG within 10 minutes of first medical contact; the case's 300/600 s window is a sim-design derivation of that anchor (review-pending).",
      "evidenceRefs": ["EV-STEMI-010"]
    },
    {
      "id": "c_aspirin_loading",
      "label": "Gave the aspirin loading dose early",
      "criticality": "critical",
      "acceptedActions": ["give_aspirin"],
      "timingWindow": {
        "fullCreditBeforeSec": 480,
        "zeroCreditAfterSec": 720
      },
      "stateConstraints": [],
      "points": 10,
      "category": "critical",
      "harmful": false,
      "rationale": "Aspirin loading (300 mg chewed — inside both AHA 162–325 and ESC 150–300 ranges; divergence D1, review-pending).",
      "evidenceRefs": ["EV-STEMI-030"]
    },
    {
      "id": "c_cath_lab_activation",
      "label": "Activated the cath lab within the target window",
      "criticality": "critical",
      "acceptedActions": ["activate_cath_lab"],
      "timingWindow": {
        "fullCreditBeforeSec": 600,
        "zeroCreditAfterSec": 900
      },
      "stateConstraints": [],
      "points": 25,
      "category": "critical",
      "harmful": false,
      "rationale": "Primary PCI is the reperfusion strategy at a PCI-capable center; arrival-to-activation is the sim's measurable proxy for FMC-to-device (divergence D5, review-pending).",
      "evidenceRefs": ["EV-STEMI-020", "EV-STEMI-021"]
    },
    {
