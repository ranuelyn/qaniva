  "metadata": {
    "title": "Crushing chest pain in a 54-year-old",
    "clinicalVersion": "0.1-draft",
    "chiefComplaint": "Severe central chest pain for the last 90 minutes",
    "briefing": [
      "Role: you are the ED doctor receiving this patient in the resuscitation room.",
      "Setting: an urban PCI-capable hospital, weekday daytime. The cath lab is operational; cardiology and interventional cardiology are on call.",
      "Resources: monitor/defibrillator, ED drug stock, laboratory, portable X-ray, a resus nurse.",
      "Triage note: \"54M, severe central chest pain for 90 minutes, sweaty. Triage category 2 — taken to resus.\"",
      "Your task: assess and manage the patient until a disposition decision. Time advances with your actions — it matters.",
      "This is an educational simulation of a fictional patient. Act as you would clinically."
    ],
    "specialty": "emergency_medicine",
    "estimatedMinutes": 10,
    "authors": ["qaniva-clinical-content (AI-assisted, evidence-ledger-backed)"],
    "clinicalReview": {
      "status": "mvp_demo_approved",
      "reviewer": null,
      "date": null,
      "notes": "MVP DEMO APPROVED by the project owner for INTERNAL/DEMO educational use only. CLINICAL VALIDATION: PENDING — no clinician has completed docs/clinical/cases/stemi/REVIEW.md. Every clinical value traces to docs/clinical/cases/stemi/evidence.yaml (EV-… ids in evidenceRefs) and retains its review-pending provenance. This case must not be represented as clinically approved."
    },
    "fictional": true
  },
  "learningObjectives": [
    "Obtain a 12-lead ECG within 10 minutes of arrival for acute chest pain and identify the need for emergent reperfusion (EV-STEMI-010, EV-STEMI-014)",
    "Initiate guideline-based initial medical therapy — aspirin loading plus appropriate adjuncts — without delaying reperfusion (EV-STEMI-030, EV-STEMI-031)",
    "Select primary PCI and activate the cath lab within the target window at a PCI-capable center (EV-STEMI-020, EV-STEMI-021)",
    "Avoid non-indicated and harmful interventions: routine oxygen at normal SpO2, NSAID analgesia, fibrinolysis when primary PCI is immediately available (EV-STEMI-033, EV-STEMI-038, EV-STEMI-023)",
    "Maintain monitoring and access appropriate for early VF risk (EV-STEMI-013, EV-STEMI-016)"
  ],
