  "transitionRules": [
    {
      "id": "ntg_bp_response",
      "when": "flag('ntg_active') && vitals.sbpMmHg < 100",
      "priority": 220,
      "once": false,
      "delaySec": 0,
      "effects": [
        {
          "op": "adjust",
          "target": "vitals.sbpMmHg",
          "value": -15
        },
        {
          "op": "clearFlag",
          "flag": "ntg_active"
        }
      ],
      "presentationCue": null,
      "terminalState": null,
      "debriefText": "Nitroglycerin was given while the patient was already hypotensive — the blood pressure dropped further."
    },
    {
      "id": "ntg_processed",
      "when": "flag('ntg_active')",
      "priority": 10,
      "once": false,
      "delaySec": 0,
      "effects": [
        {
          "op": "clearFlag",
          "flag": "ntg_active"
        }
      ],
      "presentationCue": null,
      "terminalState": null
    },
    {
      "id": "t1_ischemia_worsens",
      "when": "simTimeSec >= 720 && !flag('cath_activated') && !flag('vf_arrest')",
      "priority": 100,
      "once": true,
      "delaySec": 0,
      "effects": [
        {
          "op": "adjust",
          "target": "vitals.hr",
          "value": 12
        },
        {
          "op": "adjust",
          "target": "vitals.sbpMmHg",
          "value": -22
        },
        {
          "op": "adjust",
          "target": "vitals.dbpMmHg",
          "value": -10
        },
        {
          "op": "adjust",
          "target": "painScore",
          "value": 1
        },
        {
          "op": "setFlag",
          "flag": "deteriorated"
        }
      ],
      "presentationCue": "distress_severe",
      "terminalState": null,
      "debriefText": "No reperfusion decision was made in time — the untreated ischemia progressed (heart rate up, blood pressure down, pain worse)."
    },
    {
      "id": "t2_vf_arrest",
      "when": "simTimeSec >= 1080 && !flag('cath_activated')",
      "priority": 200,
      "once": true,
      "delaySec": 0,
      "effects": [
        {
          "op": "setEnum",
          "target": "circulation",
          "value": "arrest"
        },
        {
          "op": "setEnum",
          "target": "neuro",
          "value": "unresponsive"
        },
        {
          "op": "setRhythm",
          "value": "ventricular_fibrillation"
        },
        {
          "op": "setFlag",
          "flag": "vf_arrest"
        }
      ],
      "presentationCue": "arrest",
      "terminalState": "vf_arrest_takeover",
      "debriefText": "Prolonged untreated ischemia ended in ventricular fibrillation — the resus team takes over."
    },
    {
      "id": "troponin_returns",
      "when": "flag('troponin_sent')",
      "priority": 20,
      "once": true,
      "delaySec": 1200,
      "effects": [
        {
          "op": "disclose",
          "factId": "troponin_result"
        },
        {
          "op": "setFlag",
          "flag": "troponin_resulted"
        }
      ],
      "presentationCue": null,
      "terminalState": null
    },
    {
      "id": "labs_return",
      "when": "flag('labs_sent')",
      "priority": 20,
      "once": true,
      "delaySec": 600,
      "effects": [
        {
          "op": "disclose",
          "factId": "labs_result"
        }
      ],
      "presentationCue": null,
      "terminalState": null
    },
    {
      "id": "cxr_returns",
      "when": "flag('cxr_ordered')",
      "priority": 20,
      "once": true,
      "delaySec": 300,
      "effects": [
        {
          "op": "disclose",
          "factId": "cxr_result"
        }
      ],
