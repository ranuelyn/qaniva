<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!--
    Qaniva in-simulation interaction UI.
    Every value rendered here comes from the engine via SimulationBridgeController:
    vitals/state from SimulationSnapshotView, the action list from
    GetActionAvailability(), history from GetTimeline(). The UI never computes
    clinical truth. See docs/architecture/simulation-ui.md.

    Layout model: the scene owns the screen; a compact ACTION SHEET rises from
    the bottom (grabber + quiet utilities, category dock, decision rows). The
    sheet collapses to its dock so the patient stays dominant.
  -->
  <ui:VisualElement name="root" class="root">

    <!-- A. safe-area top spacer (adjusted at runtime) + vitals strip -->
    <ui:VisualElement name="safe-top" class="safe-top" />
    <ui:VisualElement name="vitals-bar" class="vitals-bar">
      <ui:VisualElement class="vital-tile">
        <ui:Label class="vital-caption" text="NABIZ" />
        <ui:Label name="vital-hr" class="vital" text="--" />
      </ui:VisualElement>
      <ui:VisualElement class="vital-tile">
        <ui:Label class="vital-caption" text="TA" />
        <ui:Label name="vital-bp" class="vital" text="--/--" />
      </ui:VisualElement>
      <ui:VisualElement class="vital-tile">
        <ui:Label class="vital-caption" text="SpO2" />
        <ui:Label name="vital-spo2" class="vital" text="--" />
      </ui:VisualElement>
      <ui:VisualElement class="vital-tile">
        <ui:Label class="vital-caption" text="SS" />
        <ui:Label name="vital-rr" class="vital" text="--" />
      </ui:VisualElement>
      <ui:VisualElement class="vital-tile vital-tile-clock">
        <ui:Label class="vital-caption" text="SÜRE" />
        <ui:Label name="sim-clock" class="vital clock" text="00:00" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="patient-status" class="patient-status" text="" />
    </ui:VisualElement>

    <!-- B. scene passthrough: the 3D view shows through this flexible region -->
    <ui:VisualElement name="scene-spacer" class="scene-spacer" picking-mode="Ignore" />

    <!-- E. last action result feedback -->
    <ui:VisualElement name="result-banner" class="result-banner hidden">
      <ui:Label name="result-text" class="result-text" text="" />
      <ui:Button name="result-view-button" class="result-view-button hidden" text="Sonucu aç" />
    </ui:VisualElement>

    <!-- F. full-screen result viewer (generic: ECG now, imaging later). -->
    <ui:VisualElement name="result-viewer" class="result-viewer hidden">
      <ui:Label name="result-viewer-title" class="result-viewer-title" text="" />
      <ui:Label name="result-viewer-note" class="result-viewer-note" text="" />
      <ui:VisualElement name="result-viewer-stage" class="result-viewer-stage">
        <ui:ScrollView name="result-viewer-scroll" class="result-viewer-scroll"
                       mode="VerticalAndHorizontal">
          <ui:VisualElement name="result-viewer-image" class="result-viewer-image" />
        </ui:ScrollView>
      </ui:VisualElement>
      <ui:VisualElement name="result-viewer-controls" class="result-viewer-controls">
        <ui:VisualElement name="result-viewer-zoom" class="result-viewer-zoom">
          <ui:Button name="result-zoom-out" class="viewer-button" text="−" />
          <ui:Button name="result-zoom-in" class="viewer-button" text="+" />
        </ui:VisualElement>
        <ui:Button name="result-viewer-close" class="viewer-button close" text="Kapat" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- H. completion overlay -->
    <ui:VisualElement name="completion-panel" class="completion-panel hidden">
      <ui:Label name="completion-title" class="completion-title" text="Vaka tamamlandı" />
      <ui:Label name="completion-detail" class="completion-detail" text="" />
    </ui:VisualElement>

    <!-- N. case log (engine timeline), collapsed by default -->
    <ui:VisualElement name="timeline-panel" class="timeline-panel hidden">
      <ui:Label class="timeline-title" text="Vaka günlüğü" />
      <ui:ScrollView name="timeline-scroll" class="timeline-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
    </ui:VisualElement>

    <!-- C+D. clinical action layer: category rails on both screen edges (thumb
         reach, patient stays central), a side panel with the chosen category's
         decision rows, and a floating utility bar at the bottom. -->
    <ui:VisualElement name="action-area" class="action-area panel-closed" picking-mode="Ignore">
      <ui:VisualElement name="rail-left" class="rail rail-left" picking-mode="Ignore" />
      <ui:VisualElement name="rail-right" class="rail rail-right" picking-mode="Ignore" />
      <ui:VisualElement name="category-tabs" class="hidden" />
      <ui:VisualElement name="action-panel" class="action-panel">
        <ui:VisualElement name="panel-header" class="panel-header">
          <ui:Label name="panel-title" class="panel-title" text="" />
          <ui:Button name="panel-close" class="panel-close" text="Kapat" />
        </ui:VisualElement>
        <ui:ScrollView name="action-list" class="action-list" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" />
      </ui:VisualElement>
      <ui:VisualElement name="utility-bar" class="utility-bar">
        <ui:Button name="toggle-timeline" class="utility-button" text="Vaka günlüğü" />
        <ui:Button name="sheet-handle" class="hidden" text="" />
        <ui:Button name="exit-button" class="utility-button exit" text="Çık" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="safe-bottom" class="safe-bottom" />
  </ui:VisualElement>
</ui:UXML>
