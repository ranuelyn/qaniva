<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!--
    Qaniva in-simulation interaction UI (MVP foundation, not final UX).
    Every value rendered here comes from the engine via SimulationBridgeController:
    vitals/state from SimulationSnapshotView, the action list from
    GetActionAvailability(), history from GetTimeline(). The UI never computes
    clinical truth. See docs/architecture/simulation-ui.md.
  -->
  <ui:VisualElement name="root" class="root">

    <!-- A. safe-area top spacer (adjusted at runtime) + vitals -->
    <ui:VisualElement name="safe-top" class="safe-top" />
    <ui:VisualElement name="vitals-bar" class="vitals-bar">
      <ui:Label name="vital-hr" class="vital" text="HR --" />
      <ui:Label name="vital-bp" class="vital" text="BP --/--" />
      <ui:Label name="vital-spo2" class="vital" text="SpO2 --" />
      <ui:Label name="vital-rr" class="vital" text="RR --" />
      <ui:Label name="sim-clock" class="vital clock" text="00:00" />
    </ui:VisualElement>
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="patient-status" class="patient-status" text="" />
    </ui:VisualElement>

    <!-- B. scene passthrough: the 3D view shows through this flexible region -->
    <ui:VisualElement name="scene-spacer" class="scene-spacer" picking-mode="Ignore" />

    <!-- E. last action result feedback -->
    <ui:VisualElement name="result-banner" class="result-banner hidden">
      <ui:Label name="result-text" class="result-text" text="" />
      <ui:Button name="result-view-button" class="result-view-button hidden" text="Open result" />
    </ui:VisualElement>

    <!-- F. full-screen result viewer (generic: ECG now, imaging later).
         Pan = native ScrollView touch drag; zoom = simple +/- controls. -->
    <ui:VisualElement name="result-viewer" class="result-viewer hidden">
      <ui:Label name="result-viewer-title" class="result-viewer-title" text="" />
      <ui:Label name="result-viewer-note" class="result-viewer-note" text="" />
      <ui:VisualElement name="result-viewer-stage" class="result-viewer-stage">
        <ui:ScrollView name="result-viewer-scroll" class="result-viewer-scroll"
                       mode="VerticalAndHorizontal">
          <ui:VisualElement name="result-viewer-image" class="result-viewer-image" />
        </ui:ScrollView>
      </ui:VisualElement>
      <ui:VisualElement name="result-viewer-controls" class="result-viewer-controls">
        <ui:VisualElement name="result-viewer-zoom" class="result-viewer-zoom">
          <ui:Button name="result-zoom-out" class="viewer-button" text="−" />
          <ui:Button name="result-zoom-in" class="viewer-button" text="+" />
        </ui:VisualElement>
        <ui:Button name="result-viewer-close" class="viewer-button close" text="Close" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- H. completion overlay -->
    <ui:VisualElement name="completion-panel" class="completion-panel hidden">
      <ui:Label name="completion-title" class="completion-title" text="Case complete" />
      <ui:Label name="completion-detail" class="completion-detail" text="" />
    </ui:VisualElement>

    <!-- N. case log (engine timeline), collapsed by default -->
    <ui:VisualElement name="timeline-panel" class="timeline-panel hidden">
      <ui:ScrollView name="timeline-scroll" class="timeline-scroll" />
    </ui:VisualElement>

    <!-- C+D. action navigation: category tabs + action list -->
    <ui:VisualElement name="action-area" class="action-area">
      <ui:VisualElement name="category-tabs" class="category-tabs" />
      <ui:ScrollView name="action-list" class="action-list" />
      <ui:VisualElement name="footer" class="footer">
        <ui:Button name="toggle-timeline" class="footer-button" text="Case log" />
        <ui:Button name="exit-button" class="footer-button exit" text="Exit" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="safe-bottom" class="safe-bottom" />
  </ui:VisualElement>
</ui:UXML>
