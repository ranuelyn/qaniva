/* Qaniva simulation UI — calm clinical ink/teal, phone portrait, big tap targets. */

.root {
  flex-grow: 1;
  justify-content: flex-start;
}

.safe-top { height: 54px; }
.safe-bottom { height: 24px; }

.vitals-bar {
  flex-direction: row;
  justify-content: space-between;
  background-color: rgba(14, 17, 22, 0.94);
  padding: 10px 14px;
}

.vital {
  color: rgb(70, 201, 139);
  font-size: 28px;
  -unity-font-style: bold;
}

.clock { color: rgb(237, 241, 245); }

.status-bar {
  background-color: rgba(14, 17, 22, 0.82);
  padding: 4px 14px;
}

.patient-status {
  color: rgb(152, 164, 177);
  font-size: 22px;
}

.scene-spacer { flex-grow: 1; }

.result-banner {
  background-color: rgba(23, 28, 35, 0.97);
  border-left-width: 4px;
  border-left-color: rgb(62, 198, 180);
  margin: 8px 12px;
  padding: 10px 14px;
  max-height: 300px;
  border-radius: 12px;
}

.result-text {
  color: rgb(237, 241, 245);
  font-size: 24px;
  white-space: normal;
}

.completion-panel {
  background-color: rgba(23, 45, 39, 0.97);
  margin: 8px 12px;
  padding: 14px;
  border-radius: 10px;
}

.completion-title {
  color: rgb(70, 201, 139);
  font-size: 32px;
  -unity-font-style: bold;
}

.completion-detail {
  color: rgb(237, 241, 245);
  font-size: 24px;
  white-space: normal;
}

.timeline-panel {
  background-color: rgba(23, 28, 35, 0.97);
  margin: 8px 12px;
  padding: 8px;
  max-height: 420px;
  border-radius: 10px;
}

.timeline-entry {
  color: rgb(205, 214, 223);
  font-size: 22px;
  padding: 6px 8px;
  white-space: normal;
}

.action-area {
  background-color: rgba(14, 17, 22, 0.97);
  padding: 8px 10px 4px 10px;
}

.category-tabs {
  flex-direction: row;
  margin: 2px 2px 10px 2px;
  padding: 4px;
  background-color: rgb(23, 28, 35);
  border-radius: 12px;
}

.category-tab {
  flex-grow: 1;
  flex-basis: 0;
  height: 58px;
  margin: 0;
  font-size: 24px;
  color: rgb(152, 164, 177);
  background-color: rgba(0, 0, 0, 0);
  border-width: 0;
  border-radius: 9px;
}

.category-tab-active {
  background-color: rgb(62, 198, 180);
  color: rgb(6, 35, 30);
  -unity-font-style: bold;
}

.action-list { max-height: 460px; }

.action-button {
  height: 78px;
  margin: 4px 2px;
  font-size: 26px;
  color: rgb(237, 241, 245);
  background-color: rgb(23, 28, 35);
  border-width: 0;
  border-left-width: 3px;
  border-left-color: rgb(42, 50, 61);
  border-radius: 10px;
  -unity-text-align: middle-left;
  padding-left: 22px;
}

.action-button:active {
  background-color: rgb(31, 38, 48);
  border-left-color: rgb(62, 198, 180);
}

.action-button-disabled {
  background-color: rgba(23, 28, 35, 0.55);
  border-left-color: rgba(42, 50, 61, 0.5);
  color: rgb(85, 96, 107);
}

.action-disabled-reason {
  color: rgb(232, 163, 61);
  font-size: 20px;
  margin: -2px 2px 6px 26px;
  white-space: normal;
}

.footer {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8px;
  padding-top: 6px;
  border-top-width: 1px;
  border-top-color: rgb(42, 50, 61);
}

.footer-button {
  height: 60px;
  min-width: 200px;
  font-size: 25px;
  color: rgb(205, 214, 223);
  background-color: rgb(31, 38, 48);
  border-width: 0;
  border-radius: 8px;
}

.exit { color: rgb(229, 72, 77); }

.hidden { display: none; }

/* --- result viewer (generic asset results: ECG now, imaging later) ------- */

.result-view-button {
  height: 54px;
  margin-top: 8px;
  font-size: 24px;
  color: rgb(6, 35, 30);
  background-color: rgb(62, 198, 180);
  border-width: 0;
  border-radius: 8px;
}

/* Full-screen diagnostic sheet: the asset is the focal point, everything
   else is a slim header (title + provenance) and a slim footer (zoom + Close).
   The action drawer is hidden by the presenter while the viewer is open. */
.result-viewer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgb(14, 17, 22);
  padding: 132px 16px 34px 16px;
}

.result-viewer-title {
  font-size: 40px;
  color: rgb(237, 241, 245);
  -unity-font-style: bold;
  margin: 0 4px 4px 4px;
}

.result-viewer-note {
  font-size: 21px;
  color: rgb(232, 163, 61);
  margin: 0 4px 12px 4px;
  white-space: normal;
}

/* The stage fills the free space and centers the scroll surface; the scroll
   surface itself hugs the asset (up to the stage bounds), so a width-fit ECG
   floats centered with no dead canvas and no margin-driven layout feedback. */
.result-viewer-stage {
  flex-grow: 1;
  justify-content: center;
  align-items: center;
}

.result-viewer-scroll {
  flex-grow: 0;
  flex-shrink: 1;
  max-height: 100%;
  align-self: stretch;
  background-color: rgb(23, 28, 35);
  border-radius: 16px;
  padding: 10px;
}

.result-viewer-image {
  flex-shrink: 0;
  align-self: center;
  background-color: rgb(255, 255, 255);
  border-radius: 6px;
}

.result-viewer-controls {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 14px;
}

.result-viewer-zoom { flex-direction: row; }

.viewer-button {
  height: 68px;
  min-width: 110px;
  font-size: 30px;
  color: rgb(205, 214, 223);
  background-color: rgb(23, 28, 35);
  border-width: 0;
  border-radius: 12px;
  margin-right: 10px;
}

.viewer-button.close {
  min-width: 260px;
  margin-right: 0;
  color: rgb(6, 35, 30);
  background-color: rgb(62, 198, 180);
  -unity-font-style: bold;
}
