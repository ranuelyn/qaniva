/* Qaniva simulation UI — "Qaniva entering simulation mode".
   Panel reference = 1206×2622 (1 panel px = 1 device px on iPhone 16 Pro), so
   type is sized to the shell's scale: 1pt ≈ 3px. Body 15pt → 45px, secondary
   13pt → 39px, caption 11pt → 33px. Ink surfaces, teal for selection/primary
   only, semantic colors always paired with text. */

.root {
  flex-grow: 1;
  justify-content: flex-start;
}

.safe-top { height: 54px; }
.safe-bottom { height: 24px; }

/* --- top strip: vitals tiles + humanized status --------------------------- */

.vitals-bar {
  flex-direction: row;
  justify-content: space-between;
  background-color: rgba(14, 17, 22, 0.94);
  padding: 14px 28px 8px 28px;
}

.vital-tile { flex-direction: column; }
.vital-tile-clock { align-items: flex-end; }

.vital-caption {
  color: rgb(107, 118, 132);
  font-size: 30px;
  letter-spacing: 2px;
  -unity-font-style: bold;
}

.vital {
  color: rgb(237, 241, 245);
  font-size: 50px;
  -unity-font-style: bold;
  margin-top: -2px;
}

.clock { color: rgb(62, 198, 180); }

.status-bar {
  background-color: rgba(14, 17, 22, 0.86);
  padding: 4px 28px 14px 28px;
}

.patient-status {
  color: rgb(152, 164, 177);
  font-size: 33px;
}

.scene-spacer { flex-grow: 1; }

/* --- last-action feedback card -------------------------------------------- */

.result-banner {
  background-color: rgba(23, 28, 35, 0.96);
  border-left-width: 4px;
  border-left-color: rgb(62, 198, 180);
  margin: 8px 20px;
  padding: 20px 26px;
  max-height: 340px;
  border-radius: 18px;
}

.result-text {
  color: rgb(237, 241, 245);
  font-size: 36px;
  white-space: normal;
}

.result-view-button {
  height: 88px;
  margin-top: 14px;
  font-size: 36px;
  color: rgb(6, 35, 30);
  background-color: rgb(62, 198, 180);
  border-width: 0;
  border-radius: 14px;
  -unity-font-style: bold;
}

.completion-panel {
  background-color: rgba(23, 45, 39, 0.97);
  margin: 8px 20px;
  padding: 26px;
  border-radius: 18px;
}

.completion-title {
  color: rgb(70, 201, 139);
  font-size: 48px;
  -unity-font-style: bold;
}

.completion-detail {
  color: rgb(237, 241, 245);
  font-size: 36px;
  white-space: normal;
}

/* --- case log --------------------------------------------------------------- */

.timeline-panel {
  background-color: rgba(23, 28, 35, 0.98);
  margin: 8px 20px;
  padding: 20px 8px 12px 8px;
  max-height: 620px;
  border-radius: 18px;
}

.timeline-title {
  color: rgb(107, 118, 132);
  font-size: 30px;
  letter-spacing: 2px;
  -unity-font-style: bold;
  margin: 0 18px 10px 18px;
}

.timeline-entry {
  color: rgb(205, 214, 223);
  font-size: 34px;
  padding: 12px 18px;
  border-bottom-width: 1px;
  border-bottom-color: rgb(42, 50, 61);
  white-space: normal;
}

/* --- clinical action layer: edge rails + side panel + utility bar ----------- */

.action-area {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
}

.rail {
  position: absolute;
  top: 640px;
  width: 76px;
  height: 1200px;
}
.rail-left { left: 0; }
.rail-right { right: 0; }

/* Each tab is laid out as a 236×72 box and rotated 90° into the rail; the
   presenter positions them absolutely (top = index*252 + 82, left = -80). */
.rail-tab {
  position: absolute;
  width: 236px;
  height: 72px;
  left: -80px;
  margin: 0;
  padding: 0;
  font-size: 33px;
  letter-spacing: 1px;
  color: rgb(205, 214, 223);
  background-color: rgba(14, 17, 22, 0.90);
  border-width: 1px;
  border-color: rgb(42, 50, 61);
  border-radius: 14px;
  -unity-text-align: middle-center;
}
.rail-left .rail-tab { rotate: 90deg; }
.rail-right .rail-tab { rotate: -90deg; }
.rail-tab:active { background-color: rgb(31, 38, 48); }
.rail-tab.category-tab-active {
  color: rgb(6, 35, 30);
  background-color: rgb(62, 198, 180);
  border-color: rgb(62, 198, 180);
  -unity-font-style: bold;
}

.action-panel {
  position: absolute;
  top: 560px;
  max-height: 1500px;
  width: 860px;
  background-color: rgba(14, 17, 22, 0.97);
  border-width: 1px;
  border-color: rgb(42, 50, 61);
  border-radius: 26px;
  padding: 10px 14px 12px 14px;
}
.panel-from-left  { left: 90px; }
.panel-from-right { right: 90px; }
.panel-closed .action-panel { display: none; }

.panel-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 6px 8px 10px 14px;
  border-bottom-width: 1px;
  border-bottom-color: rgb(42, 50, 61);
}
.panel-title {
  font-size: 36px;
  color: rgb(237, 241, 245);
  -unity-font-style: bold;
}
.panel-close {
  height: 64px;
  min-width: 120px;
  padding: 0 22px;
  margin: 0;
  font-size: 30px;
  color: rgb(152, 164, 177);
  background-color: rgb(23, 28, 35);
  border-width: 0;
  border-radius: 32px;
}

.utility-bar {
  position: absolute;
  left: 0; right: 0; bottom: 118px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.utility-button {
  height: 76px;
  min-width: 240px;
  margin: 0 10px;
  padding: 0 28px;
  font-size: 32px;
  color: rgb(205, 214, 223);
  background-color: rgba(14, 17, 22, 0.92);
  border-width: 1px;
  border-color: rgb(42, 50, 61);
  border-radius: 38px;
}
.utility-button:active { background-color: rgb(31, 38, 48); }
.utility-button.exit { color: rgb(229, 72, 77); min-width: 160px; }

/* decision rows (inside the panel) */
.action-list { flex-grow: 0; flex-shrink: 1; max-height: 1250px; margin-top: 4px; }

.action-row {
  flex-direction: row;
  align-items: center;
  min-height: 124px;
  margin: 0;
  padding: 16px 6px 16px 10px;
  background-color: rgba(0, 0, 0, 0);
  border-width: 0;
  border-bottom-width: 1px;
  border-bottom-color: rgb(34, 41, 51);
  border-radius: 0;
  -unity-text-align: middle-left;
}
.action-row:active { background-color: rgb(23, 28, 35); }
.action-row-copy { flex-grow: 1; flex-shrink: 1; }
.action-row-title { color: rgb(237, 241, 245); font-size: 40px; white-space: normal; }
.action-row-secondary { color: rgb(152, 164, 177); font-size: 32px; margin-top: 4px; white-space: normal; }
.action-row-status { color: rgb(62, 198, 180); font-size: 31px; margin-left: 18px; flex-shrink: 0; }
.action-row-chevron { color: rgb(107, 118, 132); font-size: 42px; margin-left: 18px; flex-shrink: 0; }
.action-row-disabled .action-row-title { color: rgb(107, 118, 132); }
.action-row-disabled .action-row-secondary { color: rgb(85, 96, 107); }
.action-row-disabled .action-row-status { color: rgb(107, 118, 132); }
.action-row-done .action-row-status { color: rgb(70, 201, 139); }

/* the result card floats above the utility bar */
.result-banner { position: absolute; left: 20px; right: 20px; bottom: 222px; margin: 0; }
.completion-panel { position: absolute; left: 20px; right: 20px; bottom: 222px; margin: 0; }
.timeline-panel { position: absolute; left: 20px; right: 20px; bottom: 222px; margin: 0; }

.hidden { display: none; }

/* --- result viewer (full-screen diagnostic sheet) --------------------------- */

.result-viewer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgb(14, 17, 22);
  padding: 140px 24px 40px 24px;
}

.result-viewer-title {
  font-size: 54px;
  color: rgb(237, 241, 245);
  -unity-font-style: bold;
  margin: 0 4px 6px 4px;
}

.result-viewer-note {
  font-size: 31px;
  color: rgb(232, 163, 61);
  margin: 0 4px 18px 4px;
  white-space: normal;
}

.result-viewer-stage {
  flex-grow: 1;
  justify-content: center;
  align-items: center;
}

.result-viewer-scroll {
  flex-grow: 0;
  flex-shrink: 1;
  max-height: 100%;
  align-self: stretch;
  background-color: rgb(23, 28, 35);
  border-radius: 20px;
  padding: 12px;
}

.result-viewer-image {
  flex-shrink: 0;
  align-self: center;
  background-color: rgb(255, 255, 255);
  border-radius: 8px;
}

.result-viewer-controls {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
}

.result-viewer-zoom { flex-direction: row; }

.viewer-button {
  height: 92px;
  min-width: 132px;
  font-size: 40px;
  color: rgb(205, 214, 223);
  background-color: rgb(23, 28, 35);
  border-width: 0;
  border-radius: 16px;
  margin-right: 12px;
}

.viewer-button.close {
  min-width: 300px;
  margin-right: 0;
  color: rgb(6, 35, 30);
  background-color: rgb(62, 198, 180);
  -unity-font-style: bold;
}
