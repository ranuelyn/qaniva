<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qaniva.Clinical.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit analyzer suggestions should not fail the clinical CI gate. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Qaniva.Clinical.Core/Qaniva.Clinical.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../packages/case-schema/fixtures/demo_sync_bradycardia_001/v1/case.json"
          Link="TestData/case.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
